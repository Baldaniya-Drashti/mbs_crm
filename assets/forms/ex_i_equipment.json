                    "options": [
                        "Yes",
                        "No",
                        "N/A"
                    ]
                },
                {
                    "label": "2 - C, D Equipment installed is that specified in the documentation",
                    "type": "dropdown",
                    "options": [
                        "Yes",
                        "No",
                        "N/A"
                    ]
                },
                {
                    "label": "3 - C, D Circuit and / or equipment category and group correct",
                    "type": "dropdown",
                    "options": [
                        "Yes",
                        "No",
                        "N/A"
                    ]
                },
                {
                    "label": "4 - C, D IP rating of equipment is appropriate to the Group III material present",
                    "type": "dropdown",
                    "options": [
                        "Yes",
                        "No",
                        "N/A"
                    ]
                },
                {
